---
import { depoimentos } from '../config/site';

/** Monograma tipográfico. Evita avatar genérico e foto de pessoa inventada. */
const iniciais = (nome: string) =>
  nome
    .split(' ')
    .filter((p) => p.length > 2)
    .slice(0, 2)
    .map((p) => p[0])
    .join('');
---

<section class="border-y border-line bg-surface-alt py-16 md:py-24">
  <div class="wrap">
    <h2 class="max-w-[20ch] font-display text-3xl sm:text-4xl">Quem já passou por isso</h2>

    <div class="reveal mt-10 grid gap-5 md:grid-cols-3">
      {
        depoimentos.map((d) => (
          <figure class="card flex flex-col p-7">
            <blockquote class="flex-1 text-lg leading-relaxed">
              <p>{d.quote}</p>
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-line pt-5">
              <span
                aria-hidden="true"
                class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-100 font-display text-sm font-bold text-brand-700"
              >
                {iniciais(d.name)}
              </span>
              <span>
                <span class="block font-semibold">{d.name}</span>
                <span class="block text-sm text-ink-soft">{d.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
