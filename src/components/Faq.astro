---
import { Icon } from 'astro-icon/components';
import { contact } from '../config/site';

interface Props {
  items: readonly { q: string; a: string }[];
  heading?: string;
}

const { items, heading = 'Perguntas que sempre aparecem' } = Astro.props;
const whatsapp = `https://wa.me/${contact.whatsapp}`;
---

<!--
  Duas colunas: o acordeão é elemento interativo de verdade, então a coluna da
  esquerda não é texto de enfeite. Em uma coluna só, o bloco deixava metade da
  tela vazia no desktop.
  O <details> nativo abre, fecha, responde ao teclado e é anunciado corretamente
  por leitor de tela sem nenhuma linha de JavaScript.
-->
<section class="wrap py-16 md:py-24">
  <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <div class="lg:sticky lg:top-28">
        <h2 class="max-w-[16ch] font-display text-3xl sm:text-4xl">{heading}</h2>
        <p class="mt-5 max-w-[34ch] text-ink-soft">
          Ficou alguma dúvida de fora? Manda a pergunta que a gente responde.
        </p>
        <a href={whatsapp} class="btn btn-secondary mt-6">
          <Icon name="ph:whatsapp-logo-fill" class="size-5" />
          Falar no WhatsApp
        </a>
      </div>
    </div>

    <div class="divide-y divide-line border-y border-line">
      {
        items.map((item) => (
          <details class="faq group">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-semibold">
              {item.q}
              <Icon
                name="ph:plus-bold"
                class="mt-1 size-5 shrink-0 text-brand-600 transition-transform group-open:rotate-45"
              />
            </summary>
            <p class="max-w-[62ch] pb-6 text-ink-soft">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::marker {
    content: '';
  }
</style>
