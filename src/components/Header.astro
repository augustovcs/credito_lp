---
import { Icon } from 'astro-icon/components';
import { brand, nav } from '../config/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path === `${href}/`;
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur-sm">
  <div class="wrap flex h-[68px] items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${brand.name}, ir para a página inicial`}>
      <span class="grid size-9 place-items-center rounded-xl bg-brand-600 text-white">
        <Icon name="ph:sun-horizon-fill" class="size-5" />
      </span>
      <span class="font-display text-xl font-bold tracking-tight">{brand.name}</span>
    </a>

    <!-- Desktop: uma linha só, sem quebra -->
    <nav class="hidden lg:block" aria-label="Navegação principal">
      <ul class="flex items-center gap-7">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'text-[0.9375rem] font-medium transition-colors hover:text-brand-700',
                  isActive(item.href) ? 'text-brand-700 underline decoration-2 underline-offset-8' : 'text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden lg:block">
      <a href="/simulador" class="btn btn-primary !min-h-11 !text-[0.9375rem]">Simular agora</a>
    </div>

    <!-- Mobile: <details> nativo. Abre, fecha e navega por teclado sem uma linha de JS. -->
    <details class="menu lg:hidden">
      <summary
        class="grid size-11 cursor-pointer list-none place-items-center rounded-xl border border-line"
        aria-label="Abrir menu"
      >
        <Icon name="ph:list-bold" class="size-6 menu-open" />
        <Icon name="ph:x-bold" class="size-6 menu-close" />
      </summary>
      <nav class="menu-panel" aria-label="Navegação principal">
        <ul class="wrap flex flex-col gap-1 py-3">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'flex min-h-[3rem] items-center rounded-xl px-3 text-lg font-medium',
                    isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="pt-2">
            <a href="/simulador" class="btn btn-primary w-full">Simular agora</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Esconde o triângulo padrão do <summary> em todos os navegadores */
  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary::marker {
    content: '';
  }

  .menu .menu-close,
  .menu[open] .menu-open {
    display: none;
  }

  .menu[open] .menu-close {
    display: block;
  }

  .menu-panel {
    position: absolute;
    inset-inline: 0;
    top: 68px;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    box-shadow: 0 12px 24px -12px rgb(28 25 23 / 0.18);
  }
</style>
